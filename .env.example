
# Nomor WhatsApp owner, format internasional tanpa tanda +
OWNER_NUMBER=628xxxxxxxxxx

# Level logging: silent, error, warn, info, debug
LOG_LEVEL=warn

# Folder autentikasi WhatsApp
AUTH_DIR=./data/auth

# File whitelist grup yang diizinkan
GROUPS_FILE=./data/allowed-groups.json

# AI (opsional) — untuk fitur .hd via 9router
AI_API_URL=http://127.0.0.1:20128
AI_API_KEY=
AI_MODEL=ag/gemini-3.1-flash-image
AI_CHAT_MODEL=coding
